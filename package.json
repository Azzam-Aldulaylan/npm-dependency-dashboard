{
  "name": "npm-dependency-dashboard",
  "displayName": "Dependency Dashboard",
  "description": "See installed packages, available updates, and vulnerabilities in one panel.",
  "version": "0.0.1",
  "private": true,
  "preview": true,
  "license": "MIT",
  "publisher": "CHANGEME",
  "author": "Azzam Aldulaylan",
  "homepage": "https://github.com/Azzam-Aldulaylan/npm-dependency-dashboard#readme",
  "bugs": {
    "url": "https://github.com/Azzam-Aldulaylan/npm-dependency-dashboard/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Azzam-Aldulaylan/npm-dependency-dashboard.git"
  },
  "keywords": [
    "npm",
    "dependencies",
    "outdated",
    "vulnerabilities",
    "security",
    "audit",
    "dependency dashboard",
    "package management",
    "monorepo"
  ],
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "galleryBanner": {
    "color": "#1e1e1e",
    "theme": "dark"
  },
  "main": "./dist/extension.js",
  "activationEvents": [
    "workspaceContains:**/package.json",
    "onWebviewPanel:dependencyDashboard"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "This extension reads .npmrc and can run npm install, which executes code from the workspace. It stays disabled until the workspace is trusted."
    }
  },
  "contributes": {
    "commands": [
      {
        "command": "dependencyDashboard.open",
        "title": "Dependency Dashboard: Open"
      },
      {
        "command": "dependencyDashboard.refresh",
        "title": "Dependency Dashboard: Refresh"
      }
    ],
    "configuration": {
      "title": "Dependency Dashboard",
      "properties": {
        "dependencyDashboard.registry.useProjectNpmrc": {
          "type": "boolean",
          "default": true,
          "description": "Read the registry from the project's .npmrc. Values containing ${ are always rejected. Turn this off to use only your user-level .npmrc."
        },
        "dependencyDashboard.upgrade.ignoreScripts": {
          "type": "boolean",
          "default": true,
          "description": "Pass --ignore-scripts when upgrading, so package lifecycle scripts don't run."
        },
        "dependencyDashboard.cacheTtlMinutes": {
          "type": "number",
          "default": 30,
          "minimum": 0,
          "description": "How long cached dependency data stays fresh before it's rescanned, in minutes. 0 means always revalidate."
        }
      }
    }
  },
  "scripts": {
    "build:core": "tsc -p src/core/tsconfig.json",
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p src/core/tsconfig.json && tsc --noEmit -p webview/tsconfig.json",
    "pretest": "tsc -p tsconfig.json",
    "test": "node --test",
    "pretest:live": "npm run build:core",
    "test:live": "node --test scripts/live-checks/advisories-bulk-live.mjs",
    "vscode:prepublish": "node esbuild.mjs --production",
    "package": "vsce package",
    "marketplace:publish": "vsce publish"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/semver": "^7.5.0",
    "@types/vscode": "^1.90.0",
    "@vscode/vsce": "3.9.2",
    "esbuild": "^0.28.0",
    "typescript": "^5.4.0"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "semver": "^7.6.0"
  }
}
